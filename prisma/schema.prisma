// 이대리 (personal_agents) Prisma schema
// 기획서: jarvis_agents_plan_2026.md §11 참고

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentRun {
  id                 Int       @id @default(autoincrement())
  agentType          String    @map("agent_type")
  triggerType        String    @map("trigger_type")
  status             String
  modelUsed          String?   @map("model_used")
  // OPS-1 Quota Pane — 어떤 CLI provider 가 호출됐는지 (codex-cli / claude-cli / gemini-cli / mock)
  // 와 execute 시작~종료 elapsed 시간을 기록. /quota 슬래시가 provider 별 count + 평균 duration 산출.
  cliProvider        String?   @map("cli_provider")
  durationMs         Int?      @map("duration_ms")
  inputSnapshot      Json      @map("input_snapshot")
  output             Json?
  // 직무 계약(src/agent-registry/agent-contract.ts) 검수 결과. 위반이 없으면 null.
  // output 안에 섞지 않는 이유: 기존 output 소비자(콘솔 read API, 리포트 포매터)가
  // 예상하지 못한 키를 만나 깨지는 것을 피한다.
  // 1단계는 관측 모드 — 위반이 있어도 status 는 SUCCEEDED 그대로 둔다.
  contractViolations Json?     @map("contract_violations")
  // 같은 검수의 점수(0.0~1.0). 위반 유무만으로는 "필수 필드 3 개 중 1 개 누락" 과
  // "3 개 전부 누락" 이 같은 값이 되어 산출물이 나빠지는 추세가 보이지 않는다.
  // NULL 은 "검사 항목이 0 개(스텁 계약)" 를 뜻한다 — 1.0 으로 채우면 무검사가
  // 만점으로 위장돼 평균이 조용히 부풀려진다.
  contractScore      Float?    @map("contract_score")
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")

  // V3 비전 봇 쪼개기 — Hierarchical Manager Pattern 의 handoff chain 추적용 self-relation.
  // (plan: docs/superpowers/plans/2026-05-07-agent-communication-topology.md §4.4 / §6.3)
  // Router 가 dispatch chain 안에서 worker → worker handoff 를 만들 때 parent.id 를 child 에 기록.
  // onDelete: SetNull — 부모가 삭제돼도 child 의 audit log 가치는 유지.
  // @@index([parentId]) 필수 — CEO 의 weekly handoff chain 조회 시 full scan 회피 (OMC architect 권장).
  parentId Int?       @map("parent_id")
  parent   AgentRun?  @relation("AgentRunHandoff", fields: [parentId], references: [id], onDelete: SetNull)
  children AgentRun[] @relation("AgentRunHandoff")

  evidenceRecords    EvidenceRecord[]
  dailyPlan          DailyPlan?
  prReviewOutcomes   PrReviewOutcome[]
  prReviewFindings   PrReviewFinding[]
  careerProfiles     CareerProfile[]
  episodicMemories   EpisodicMemory[]
  studyBriefs        StudyBrief[]
  paperOrders        PaperOrder[]
  screeningRuns      ScreeningRun[]
  strategyParameters StrategyParameter[]
  jobPostings        JobPosting[]

  @@index([agentType, startedAt])
  @@index([parentId])
  @@map("agent_run")
}

model EvidenceRecord {
  id          Int       @id @default(autoincrement())
  agentRunId  Int?      @map("agent_run_id")
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  sourceType  String    @map("source_type")
  sourceId    String    @map("source_id")
  url         String?
  title       String?
  excerpt     String?   @db.Text
  payload     Json
  collectedAt DateTime  @default(now()) @map("collected_at")

  @@index([sourceType, sourceId])
  @@map("evidence_record")
}

// PO-2 Preview Gate — Write-back 같은 외부 부작용 명령이 사용자 confirm 후에만 실행되도록 보장.
// SlackService 가 user-facing Block Kit 메시지에 ✅ apply / ❌ cancel 버튼을 노출 → 사용자가 클릭하면
// action_id (preview:apply / preview:cancel) 가 PreviewActionId 와 함께 들어와 PENDING → APPLIED/CANCELLED 전이.
// kind 별 strategy (PreviewApplier) 가 payload 를 해석해 실제 부작용 (Notion/GitHub write 등) 을 수행.
// expiresAt 이후 PENDING 인 row 는 EXPIRED 로 자연 만료 (별도 cron 스윕 가능 — 현재는 in-place 검증).
model PreviewAction {
  id             String    @id
  slackUserId    String    @map("slack_user_id")
  kind           String
  payload        Json
  status         String
  // Slack interactivity payload 의 response_url — apply/cancel 후 원본 메시지를 update 하기 위해 보관.
  responseUrl    String?   @map("response_url")
  // 생성 시점 사용자에게 보여진 "preview text" — apply 결과 메시지에서 다시 노출하기 위해 그대로 저장.
  previewText    String    @map("preview_text") @db.Text
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  appliedAt      DateTime? @map("applied_at")
  cancelledAt    DateTime? @map("cancelled_at")
  // A 경로(chat.postMessage) 카드의 좌표 — apply/cancel/만료 시 chat.update 로 이 메시지를 다시 그린다.
  // ephemeral(B) / 카드 없음(C) 경로는 null 로 남아 갱신이 조용히 skip 된다.
  slackChannelId String?   @map("slack_channel_id")
  slackMessageTs String?   @map("slack_message_ts")

  @@index([slackUserId, status])
  // preview-sweeper 가 만료된 PENDING 을 훑는 조회용.
  @@index([status, expiresAt])
  @@map("preview_action")
}

// OPS-3 Slack Reaction → Inbox
// 사용자가 메시지에 configured emoji (기본 :raised_hand:) 를 달면 익일 /today 에 자동 흡수.
// slackUserId 는 reaction 을 단 사용자 — 이 사용자의 /today 만 해당 항목을 소비.
// 같은 메시지에 여러 사용자가 reaction 달면 각자 별도 inbox row 로 분리 (multi-user 격리).
model SlackInboxItem {
  id          Int       @id @default(autoincrement())
  slackUserId String    @map("slack_user_id")
  channelId   String    @map("channel_id")
  messageTs   String    @map("message_ts")
  text        String    @db.Text
  addedAt     DateTime  @default(now()) @map("added_at")
  consumed    Boolean   @default(false)
  consumedAt  DateTime? @map("consumed_at")

  @@unique([slackUserId, channelId, messageTs])
  @@index([slackUserId, consumed, addedAt])
  @@map("slack_inbox_item")
}

// jarvis_agents_plan_2026.md §11.1 daily_plan — "오늘 plan" 을 날짜 단위로 직접 조회할 수 있게 하는 뷰용 테이블.
// agent_run.output 에도 동일 정보가 있지만 plan_date 인덱스가 없어 날짜 기반 reporting 이 비효율.
// 같은 날 재실행 시 upsert 로 최신 plan 덮어쓰기 (planDate @unique).
model DailyPlan {
  id          Int      @id @default(autoincrement())
  planDate    DateTime @unique @map("plan_date") @db.Date
  planJson    Json     @map("plan_json")
  agentRunId  Int      @unique @map("agent_run_id")
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  evidenceIds Int[]    @map("evidence_ids")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("daily_plan")
}

// QA-1 Reviewer 룰셋 학습 — /review-pr 결과에 사용자가 accept/reject 한 history 누적.
// 다음 /review-pr 프롬프트에 reject 된 코멘트 패턴을 negative example 로 1~2개 주입.
model PrReviewOutcome {
  id          Int      @id @default(autoincrement())
  agentRunId  Int      @map("agent_run_id")
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  slackUserId String   @map("slack_user_id")
  accepted    Boolean
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([slackUserId, accepted, createdAt])
  @@map("pr_review_outcome")
}

// PR 리뷰 루프 Phase 1 — 지적 1건 = 카드 1행. 리뷰 전체 평가인 PrReviewOutcome 과 다른 개념이다.
// status 가 카드 생애의 정본이고, GitHub 은 동기화 대상이다(스펙 §4-6).
model PrReviewFinding {
  id                 Int       @id @default(autoincrement())
  agentRunId         Int       @map("agent_run_id")
  agentRun           AgentRun  @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  // 'CODE_REVIEWER' — BE_FIX 등 다른 에이전트 지적 편입 대비.
  agentType          String    @map("agent_type")
  repo               String
  pullNumber         Int       @map("pull_number")
  // 리뷰 시점 head sha — Phase 2 커밋 대조의 기준선.
  headSha            String    @map("head_sha")
  category           String
  severity           String
  filePath           String?   @map("file_path")
  line               Int?
  body               String    @db.Text
  // sha256(repo, pullNumber, filePath, 정규화 body) — 재스윕 시 중복 게시 차단.
  fingerprint        String    @unique
  // OPEN | ACKED | REJECTED | FIXED | RESOLVED | STALE | SUPPRESSED
  status             String    @default("OPEN")
  // INLINE | FILE | ISSUE_COMMENT | NOT_POSTED (연습 모드는 카드를 만들지 않음)
  postMode           String    @map("post_mode")
  githubCommentId    BigInt?   @map("github_comment_id")
  githubThreadNodeId String?   @map("github_thread_node_id")
  rejectReason       String?   @db.Text
  decidedAt          DateTime? @map("decided_at")
  resolvedAt         DateTime? @map("resolved_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([repo, pullNumber, status])
  @@index([category, severity, status])
  @@map("pr_review_finding")
}

// 휴가 사용 내역 — 기간별 누적. slackUserId 는 확장키(현재 본인 1명).
// businessDays 는 등록 시점 계산값 저장 (규칙이 바뀌어도 과거 기록 불변, 감사·재현).
// canceledAt soft-cancel — 잔여 합산 시 NULL 만 포함.
model LeaveUsage {
  id           Int       @id @default(autoincrement())
  slackUserId  String    @map("slack_user_id")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  businessDays Float     @map("business_days")
  memo         String?
  canceledAt   DateTime? @map("canceled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([slackUserId, startDate])
  @@map("leave_usage")
}

model JobApplication {
  id             Int       @id @default(autoincrement())
  slackUserId    String    @map("slack_user_id")
  company        String
  role           String
  jdUrl          String?   @map("jd_url")
  status         String
  appliedAt      DateTime  @map("applied_at") @db.Date
  deadline       DateTime? @db.Date
  nextFollowUpAt DateTime? @map("next_follow_up_at") @db.Date
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  jobPostingId Int?        @map("job_posting_id")
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  @@index([slackUserId, status])
  @@map("job_application")
}

model CareerProfile {
  id          Int       @id @default(autoincrement())
  agentRunId  Int?      @map("agent_run_id")
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  slackUserId String    @map("slack_user_id")
  githubLogin String    @map("github_login")
  windowStart DateTime  @map("window_start") @db.Date
  prCount     Int       @map("pr_count")
  summary     String    @db.Text
  profileJson Json      @map("profile_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  scoredJobPostings JobPosting[]

  @@index([slackUserId, createdAt])
  @@map("career_profile")
}

model CareerTargetJd {
  id          Int      @id @default(autoincrement())
  slackUserId String   @map("slack_user_id")
  company     String
  role        String
  jdText      String   @map("jd_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([slackUserId, createdAt])
  @@map("career_target_jd")
}

model SubconsciousBaseline {
  id          Int      @id @default(autoincrement())
  ownerUserId String   @map("owner_user_id")
  sourceId    String   @map("source_id")
  contentHash String   @map("content_hash")
  snapshot    Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, sourceId])
  @@map("subconscious_baseline")
}

model SubconsciousProposal {
  id                 Int       @id @default(autoincrement())
  ownerUserId        String    @map("owner_user_id")
  sourceId           String    @map("source_id")
  changeKey          String    @map("change_key")
  suggestedAgentType String    @map("suggested_agent_type")
  proposalText       String    @db.Text
  contextJson        Json      @map("context_json")
  status             String    @default("PENDING")
  slackChannelId     String?   @map("slack_channel_id")
  slackMessageTs     String?   @map("slack_message_ts")
  createdAt          DateTime  @default(now()) @map("created_at")
  resolvedAt         DateTime? @map("resolved_at")

  @@index([ownerUserId, status, createdAt])
  @@map("subconscious_proposal")
}

// Episodic Memory — AgentRun 완료 결과를 로컬 임베딩으로 시간축에 적재(spec 2026-06-18).
// embedding 은 pgvector 컬럼이라 Prisma 미지원 → Unsupported. 적재/검색은 $queryRaw 로만.
model EpisodicMemory {
  id           Int                         @id @default(autoincrement())
  kind         String // 'agent_run' | 'conversation' | 'manual' (1차는 'agent_run')
  agentRunId   Int?                        @map("agent_run_id")
  // onDelete: SetNull — AgentRun 삭제 시 dangling 대신 NULL 로(에피소드 audit 가치 유지).
  // FK 제약이 dangling 을 구조적으로 차단 → knowledge-lint 의 사후 L3 점검이 불요해짐(예방 > 점검).
  agentRun     AgentRun?                   @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agentType    String?                     @map("agent_type")
  content      String                      @db.Text
  embedding    Unsupported("vector(384)")?
  occurredAt   DateTime                    @map("occurred_at")
  supersededAt DateTime?                   @map("superseded_at")
  createdAt    DateTime                    @default(now()) @map("created_at")

  @@index([kind, agentType, occurredAt])
  @@map("episodic_memory")
}

model UserPreferenceProfile {
  id           Int       @id @default(autoincrement())
  ownerUserId  String    @map("owner_user_id")
  version      Int
  profileJson  Json      @map("profile_json")
  supersededAt DateTime? @map("superseded_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([ownerUserId, version])
  @@index([ownerUserId, supersededAt])
  @@map("user_preference_profile")
}

model PreferenceProposal {
  id             Int       @id @default(autoincrement())
  ownerUserId    String    @map("owner_user_id")
  baseVersion    Int       @map("base_version")
  diffJson       Json      @map("diff_json")
  rationale      String    @db.Text
  status         String    @default("PENDING")
  slackChannelId String?   @map("slack_channel_id")
  slackMessageTs String?   @map("slack_message_ts")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  @@index([ownerUserId, status, createdAt])
  @@map("preference_proposal")
}

// 보유 종목 모니터링 — 종목 마스터.
// 티커는 상장 이전·티커 변경으로 바뀔 수 있어 PK 로 쓰지 않는다.
// 유니크는 (market, code) — 6자리 코드는 시장이 다르면 중복될 수 있다.
//
// market 과 marketCountry 를 함께 두는 이유: 토스증권 API 는 marketCountry(KR/US)
// 만 주고 코스피/코스닥을 구분하지 않는 반면, Yahoo 는 접미사(.KS/.KQ)로 구분한다.
// 토스에서 동기화한 종목은 market='KR' marketCountry='KR' 로 들어오고,
// Yahoo 경로로 등록한 종목은 market='KOSPI'|'KOSDAQ' 이다.
// yahooSymbol 은 Yahoo 경로에서만 필수라 nullable 로 둔다.
model Ticker {
  id                     Int                     @id @default(autoincrement())
  code                   String
  market                 String
  marketCountry          String?                 @map("market_country")
  yahooSymbol            String?                 @map("yahoo_symbol")
  tossSymbol             String?                 @map("toss_symbol")
  name                   String
  currency               String
  // 실질 노출 분류. 표시 통화가 아니라 "기초자산이 어느 시장에 걸려 있는가"를 담는다.
  // 원화 표시 ETF 라도 기초자산이 해외면 해외로 분류한다 — 통화만으로는 구분이 안 된다.
  // null 은 미분류. 집계에서 별도 버킷으로 정직하게 드러낸다(임의로 어느 쪽에 넣지 않는다).
  exposureRegion         String?                 @map("exposure_region")
  // LONG | SHORT. 인버스·곱버스 상품을 같은 지역의 롱과 상쇄해서 읽지 않기 위한 축.
  exposureDirection      String                  @default("LONG") @map("exposure_direction")
  // KRX 상장법인 목록에서 온 세부 시장('KOSPI'|'KOSDAQ'). identity 축이 아니라 속성이다 —
  // 같은 종목이 KR 행과 KOSPI 행으로 갈라지지 않게 `market` 은 계속 'KR' 이고,
  // 세율 계산·스크리닝이 쓰는 세부 시장만 여기 담는다. 값 공간은 PaperMarket 과 같다.
  krxMarket              String?                 @map("krx_market")
  sector                 String?
  listedAt               DateTime?               @map("listed_at") @db.Date
  // 상장폐지로 목록에서 사라진 날. 유니버스 조회는 이 값이 null 인 행만 본다.
  // 행을 지우지 않는 이유: 과거 판단의 근거 종목이 사라지면 그때의 성적을 재구성할 수 없다.
  delistedAt             DateTime?               @map("delisted_at") @db.Date
  // KIND 상장폐지 현황이 준 폐지 사유 원문. 청산 회수율을 이 값으로 가른다 —
  // 합병·완전자회사화는 주주가 대가를 받지만(회수율 1 에 가깝다) 감사의견 거절·해산은 거의 0 이다.
  // 사유를 모르면 청산가를 정할 근거가 없어 마지막 종가를 그대로 쓸 수밖에 없고,
  // 그건 폐지가 손실이 아니었다고 가정하는 낙관 편향이다(목표 7).
  // 분류하지 않고 원문을 담는 이유는 밴드를 나중에 다시 가를 때 원문이 남아 있어야 하기 때문이다.
  // 상장폐지 목록에 없는 종목(생존 중이거나 KIND 수집 전에 마킹된 행)은 null 이다.
  delistingReason        String?                 @map("delisting_reason")
  source                 String                  @default("YAHOO")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  dailyPrices            DailyPrice[]
  holdings               Holding[]
  holdingChanges         HoldingChange[]
  alerts                 StockAlert[]
  paperOrders            PaperOrder[]
  paperPositions         PaperPosition[]
  paperTrades            PaperTrade[]
  paperCorporateActions  PaperCorporateAction[]
  paperPositionSnapshots PaperPositionSnapshot[]
  screeningRunItems      ScreeningRunItem[]

  @@unique([market, code])
  @@index([krxMarket, delistedAt])
  @@map("ticker")
}

// 일별 시세. Yahoo 는 액면분할 시 과거 가격을 소급 재작성하므로
// raw close 와 조정가(adjClose)를 모두 보관하고 지표 계산은 adjClose 를 쓴다.
// 재시도·휴장일 재수집으로 같은 거래일이 다시 들어올 수 있어 (tickerId, tradeDate) 로 upsert 한다.
model DailyPrice {
  id             Int       @id @default(autoincrement())
  tickerId       Int       @map("ticker_id")
  ticker         Ticker    @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  tradeDate      DateTime  @map("trade_date") @db.Date
  // 백테스트가 실전과 같은 "다음 영업일 시가 체결"을 재현하려면 시가가 필요하다.
  // 기존 행을 보존해야 하므로 nullable 이다. 재수집이 끝나면 사실상 전 행이 채워진다.
  open           Decimal?  @db.Decimal(18, 4)
  // 장중 고가·저가. 종가만 있으면 하루 안의 진폭이 통째로 사라져,
  // (1) `high200Position` 이 이름과 달리 최고 *종가* 기준이 되고
  // (2) 장중 손절(5분 주기 현재가 관측)을 과거 봉으로 재현할 수 없다.
  // open 과 같은 이유로 nullable 이다. 값 계열은 close·adjClose 와 같아서,
  // `adjusted=false` 로 받은 봉의 high 는 조정 고가가 아니라 미조정 실제 고가다.
  high           Decimal?  @db.Decimal(18, 4)
  low            Decimal?  @db.Decimal(18, 4)
  close          Decimal   @db.Decimal(18, 4)
  adjClose       Decimal   @map("adj_close") @db.Decimal(18, 4)
  volume         BigInt
  fetchedAt      DateTime  @default(now()) @map("fetched_at")
  lastResyncedAt DateTime? @map("last_resynced_at")

  @@unique([tickerId, tradeDate])
  @@index([tickerId, tradeDate])
  @@map("daily_price")
}

// 보유 상태. 가격 시계열과 달리 소급 복구가 불가능한 데이터라 이력을 남긴다.
// effectiveDate 로 시점을 구분하고, 최신 행이 현재 보유 상태다.
model Holding {
  id            Int      @id @default(autoincrement())
  tickerId      Int      @map("ticker_id")
  ticker        Ticker   @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  quantity      Decimal  @db.Decimal(18, 4)
  avgPrice      Decimal  @map("avg_price") @db.Decimal(18, 4)
  currency      String
  effectiveDate DateTime @map("effective_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([tickerId, effectiveDate])
  @@map("holding")
}

// 매매 사건 이력. Holding 은 "지금 무엇을 들고 있는가"(상태)만 담아서 "어제 무엇을 샀는가"(사건)를
// 알 수 없다. 동기화가 직전 스냅샷과 새로 읽은 잔고를 비교해 그 차이를 여기에 사건으로 남긴다.
//
// 중복 차단은 (tickerId, effectiveDate, kind) 가 아니라 fingerprint 로 한다. 잔고는 하루에 두 번
// (국내 감시·미국 감시) 갱신되므로 같은 종목이 같은 날 두 번 변할 수 있어(오전 200→230,
// 오후 230→250) 그 조합을 유니크로 잡으면 뒤에 온 실제 매매가 사라진다. 지문은 수량·평단까지
// 포함하므로 두 번째 매매는 살아남고, 겹친 실행이 계산한 똑같은 사건만 걸러진다.
model HoldingChange {
  id               Int      @id @default(autoincrement())
  tickerId         Int      @map("ticker_id")
  ticker           Ticker   @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  kind             String
  previousQuantity Decimal? @map("previous_quantity") @db.Decimal(18, 4)
  quantity         Decimal  @db.Decimal(18, 4)
  previousAvgPrice Decimal? @map("previous_avg_price") @db.Decimal(18, 4)
  avgPrice         Decimal  @map("avg_price") @db.Decimal(18, 4)
  currency         String
  effectiveDate    DateTime @map("effective_date") @db.Date
  // sha256(tickerId, effectiveDate, kind, 저장 정밀도로 정규화한 수량·평단) — 겹친 실행의 중복 적재 차단.
  fingerprint      String   @unique
  detectedAt       DateTime @default(now()) @map("detected_at")

  @@index([effectiveDate])
  @@index([tickerId, detectedAt])
  @@map("holding_change")
}

// 알림 발화 이력. 임계값을 나중에 바꿔도 과거 알림의 발생 이유를 재현할 수 있도록
// 규칙 버전과 당시 입력값·임계값을 함께 남긴다.
model StockAlert {
  id             Int            @id @default(autoincrement())
  tickerId       Int            @map("ticker_id")
  ticker         Ticker         @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  tradeDate      DateTime       @map("trade_date") @db.Date
  ruleId         String         @map("rule_id")
  ruleVersion    Int            @map("rule_version")
  triggeredValue Decimal        @map("triggered_value") @db.Decimal(18, 4)
  threshold      Decimal        @db.Decimal(18, 4)
  firedAt        DateTime       @default(now()) @map("fired_at")
  outcomes       AlertOutcome[]

  @@unique([tickerId, tradeDate, ruleId])
  @@index([tickerId, firedAt])
  @@map("stock_alert")
}

// 알림 사후 채점 — 발화 후 N거래일 뒤 실제 등락을 기록한다.
// StockAlert 를 덮어쓰지 않고 (alertId, horizonDays) 마다 한 행을 남겨,
// 여러 horizon 채점과 임계값 변경 후 재현을 가능하게 한다.
// 통계적 유의성 판정은 범위 밖 — 관측 가능한 사실(등락률)만 기록한다.
model AlertOutcome {
  id           Int        @id @default(autoincrement())
  alertId      Int        @map("alert_id")
  alert        StockAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  horizonDays  Int        @map("horizon_days")
  firedPrice   Decimal    @map("fired_price") @db.Decimal(18, 4)
  horizonPrice Decimal    @map("horizon_price") @db.Decimal(18, 4)
  returnPct    Decimal    @map("return_pct") @db.Decimal(18, 4)
  evaluatedAt  DateTime   @default(now()) @map("evaluated_at")

  @@unique([alertId, horizonDays])
  @@map("alert_outcome")
}

// 일별 환율 — 미국 종목 손익의 원화 환산 표시에만 쓴다(판정에는 쓰지 않는다).
// 판정은 종목의 거래 통화(USD) 기준으로 하므로 환율 조회가 실패해도 판정은 정상 동작하고
// 원화 병기만 생략된다. rate 는 소수 자릿수가 크므로 Decimal(18,6).
model DailyFxRate {
  id        Int      @id @default(autoincrement())
  pair      String
  rateDate  DateTime @map("rate_date") @db.Date
  rate      Decimal  @db.Decimal(18, 6)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([pair, rateDate])
  @@map("daily_fx_rate")
}

// 매일 학습 브리핑 — 보낸 주제의 원장. 다음 회차의 "제외 목록"이자 kind 균형 재료.
// reportMd 는 Hermes 조사 전문. Notion 발행 성공 여부와 무관하게 DB가 원문 정본이다.
model StudyBrief {
  id          Int       @id @default(autoincrement())
  agentRunId  Int?      @map("agent_run_id")
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  ownerUserId String    @map("owner_user_id")
  kind        String
  topic       String
  verdictJson Json      @map("verdict_json")
  reportMd    String    @map("report_md") @db.Text
  sourceUrls  Json      @map("source_urls")
  notionUrl   String?   @map("notion_url")
  // 딥다이브 확장으로 만들어진 블로그 초안 Notion page id. 값이 있으면 이미 확장한 브리프다 —
  // 같은 브리프로 두 번째 초안을 만들지 않기 위한 유일한 근거(초안 DB 는 제목이 바뀔 수 있다).
  blogDraftPageId String? @map("blog_draft_page_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([ownerUserId, createdAt])
  @@map("study_brief")
}

model PaperAccount {
  id          Int      @id @default(autoincrement())
  name        String   @unique // DEFAULT | LONG_TERM | SWING
  currency    String   @default("KRW")
  seedAmount  Decimal  @map("seed_amount") @db.Decimal(18, 4)
  cashBalance Decimal  @map("cash_balance") @db.Decimal(18, 4)
  openedAt    DateTime @map("opened_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders    PaperOrder[]
  positions PaperPosition[]
  trades    PaperTrade[]
  corporateActions PaperCorporateAction[]
  snapshots PaperEquitySnapshot[]
  scores    RecommendationScore[]
  scorePeriods RecommendationScorePeriod[]

  @@map("paper_account")
}

// 매매가 아닌 사유로 계좌의 현금이나 수량이 바뀌는 사건. 배당·분할·병합·무상증자가 들어온다.
// 이 표가 없으면 불변식(현금 = 시드 − 매수 + 매도)이 배당 입금을 위반으로 읽어
// evaluate-paper-account 가 그 계좌의 평가를 영구히 건너뛴다.
model PaperCorporateAction {
  id        Int          @id @default(autoincrement())
  accountId Int          @map("account_id")
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tickerId  Int          @map("ticker_id")
  ticker    Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  kind      String // DIVIDEND | SPLIT | MERGE | BONUS_ISSUE
  // 배당락·권리락일. 이 날 직전 거래일 종가 시점의 보유 수량이 권리 수량이다.
  exDate    DateTime     @map("ex_date") @db.Date
  payDate   DateTime?    @map("pay_date") @db.Date

  // 금액만 남기면 사후에 왜 이 값인가를 재구성할 수 없다. paper_order가
  // indicatorSnapshot을 박아 두는 것과 같은 이유로 계산 근거를 함께 보존한다.
  perShareAmount   Decimal? @map("per_share_amount") @db.Decimal(18, 4)
  eligibleQuantity Decimal? @map("eligible_quantity") @db.Decimal(18, 4)
  grossAmount      Decimal? @map("gross_amount") @db.Decimal(18, 4)
  taxAmount        Decimal? @map("tax_amount") @db.Decimal(18, 4)

  // 불변식이 읽는 두 값. 종류가 무엇이든 계좌 변화는 이 둘로 완전히 표현된다.
  cashDelta     Decimal @default(0) @map("cash_delta") @db.Decimal(18, 4)
  quantityDelta Decimal @default(0) @map("quantity_delta") @db.Decimal(18, 4)
  // 분할·병합이 평단을 바꿀 때의 조정 후 값. 배당은 평단을 낮추지 않으므로 null이다.
  avgPriceAfter Decimal? @map("avg_price_after") @db.Decimal(18, 4)

  note        String?  @db.Text
  // 재실행이 같은 사건을 두 번 넣는 것을 DB 층에서 막는다.
  fingerprint String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId, exDate])
  @@map("paper_corporate_action")
}

// 판단과 체결을 분리해 기록한다. 이 표가 없으면 "전일 종가로 판단하고 다음날 시가에 체결했다"를
// 사후에 증명할 수 없다 — 다음날 시가를 본 뒤에 만든 거래와 구별되지 않기 때문이다.
model PaperOrder {
  id                    Int          @id @default(autoincrement())
  accountId             Int          @map("account_id")
  account               PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tickerId              Int          @map("ticker_id")
  ticker                Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  side                  String // BUY | SELL
  quantity              Decimal      @db.Decimal(18, 4)
  strategy              String // LONG_TERM | SWING | MANUAL
  reason                String?      @db.Text
  decidedAt             DateTime     @map("decided_at") // 결정 시각
  dataAsOf              DateTime     @map("data_as_of") @db.Date // 판단에 사용한 마지막 거래일
  targetTradeDate       DateTime?    @map("target_trade_date") @db.Date // 체결 목표 거래일
  status                String // PENDING | FILLED | PARTIALLY_FILLED | EXPIRED | CANCELLED
  statusReason          String?      @map("status_reason") // 미체결 사유 (거래정지·상한가·유동성 등)
  // 판단에 쓴 지표를 그대로 박아 둔다. 지표 공식이나 필터를 나중에 손대면 과거 추천을 재계산할 수
  // 없게 되는데, 그때 본 숫자가 남아 있으면 "왜 이걸 골랐나"가 영구히 재구성된다.
  indicatorSnapshot     Json?        @map("indicator_snapshot")
  // 이 추천을 만든 스크리너 규칙 버전. 규칙을 고치면 이후 성적이 이전 성적과 섞이는데,
  // 추천마다 버전이 박혀 있어야 "바꿔서 나아졌나" 를 나중에 갈라 볼 수 있다.
  ruleVersion           Int?         @map("rule_version")
  // 이 매도를 만든 청산 밴드 설정. 밴드 값을 바꾸면 그 전후 성적이 한 표본에 섞이는데,
  // 매도마다 기준이 박혀 있으면 "밴드를 넓혀서 나아졌나" 를 나중에 갈라 볼 수 있다
  // (추천이 ruleVersion 으로 그렇게 하는 것과 같은 축이다).
  // 밴드가 만들지 않은 주문(매수·모델이 고른 매도)은 null 이다.
  exitTakeProfitPercent Decimal?     @map("exit_take_profit_percent") @db.Decimal(9, 4)
  exitStopLossPercent   Decimal?     @map("exit_stop_loss_percent") @db.Decimal(9, 4)
  expiresAt             DateTime?    @map("expires_at")
  agentRunId            Int?         @map("agent_run_id")
  agentRun              AgentRun?    @relation(fields: [agentRunId], references: [id])
  createdAt             DateTime     @default(now()) @map("created_at")

  trades PaperTrade[]

  @@index([accountId, status])
  @@index([targetTradeDate])
  @@map("paper_order")
}

model PaperPosition {
  id        Int          @id @default(autoincrement())
  accountId Int          @map("account_id")
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tickerId  Int          @map("ticker_id")
  ticker    Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  quantity  Decimal      @db.Decimal(18, 4)
  // 매수 수수료를 포함한 장부 원가 기준 평균단가 (§5 원가 규칙)
  avgPrice  Decimal      @map("avg_price") @db.Decimal(18, 4)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([accountId, tickerId])
  @@map("paper_position")
}

model PaperTrade {
  id          Int          @id @default(autoincrement())
  accountId   Int          @map("account_id")
  account     PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId     Int?         @map("order_id")
  order       PaperOrder?  @relation(fields: [orderId], references: [id])
  tickerId    Int          @map("ticker_id")
  ticker      Ticker       @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  side        String // BUY | SELL
  quantity    Decimal      @db.Decimal(18, 4)
  price       Decimal      @db.Decimal(18, 4) // 미조정 실제 체결가
  fee         Decimal      @db.Decimal(18, 4)
  tax         Decimal      @db.Decimal(18, 4)
  realizedPnl Decimal?     @map("realized_pnl") @db.Decimal(18, 4) // 매도 시에만
  tradeDate   DateTime     @map("trade_date") @db.Date // 체결 거래일
  // 실제 결제일(체결일 + 2영업일). 총평가와 수익률에는 영향이 없고 결제 완료 예수금 표시용이다.
  settlementDate DateTime? @map("settlement_date") @db.Date
  // 재시도·stalled 재실행이 같은 체결을 두 번 넣는 것을 DB 층에서 막는다.
  // HoldingChange 가 같은 문제를 fingerprint @unique 로 푼 선례를 따른다(schema.prisma:406).
  fingerprint String       @unique
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([accountId, tradeDate])
  @@index([tickerId, tradeDate])
  @@map("paper_trade")
}

// 종목별 평가 근거. 총액만 남기면 어느 종목을 어떤 날짜의 어떤 가격으로 평가했는지
// 사후 검증이 불가능하고, 거래정지 종목의 며칠 전 종가가 정상 평가로 위장된다.
model PaperPositionSnapshot {
  id         Int                 @id @default(autoincrement())
  snapshotId Int                 @map("snapshot_id")
  snapshot   PaperEquitySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  tickerId   Int                 @map("ticker_id")
  ticker     Ticker              @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  quantity   Decimal             @db.Decimal(18, 4)
  avgPrice   Decimal             @map("avg_price") @db.Decimal(18, 4)
  price      Decimal             @db.Decimal(18, 4)
  priceDate  DateTime            @map("price_date") @db.Date // 평가에 쓴 봉의 거래일
  isStale    Boolean             @default(false) @map("is_stale") // priceDate != snapshot.tradeDate
  createdAt  DateTime            @default(now()) @map("created_at")

  @@unique([snapshotId, tickerId])
  @@map("paper_position_snapshot")
}

model PaperEquitySnapshot {
  id               Int          @id @default(autoincrement())
  accountId        Int          @map("account_id")
  account          PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tradeDate        DateTime     @map("trade_date") @db.Date
  cashBalance      Decimal      @map("cash_balance") @db.Decimal(18, 4)
  positionValue    Decimal      @map("position_value") @db.Decimal(18, 4)
  totalValue       Decimal      @map("total_value") @db.Decimal(18, 4)
  returnRate       Decimal      @map("return_rate") @db.Decimal(9, 4)
  staleTickerCount Int          @default(0) @map("stale_ticker_count")
  // 벤치마크 없이는 "시드 대비 +8%" 가 시장 대비 초과인지 미달인지 해석되지 않는다.
  // 지나간 구간은 소급 적재가 불가능하므로 1단계부터 함께 적는다.
  benchmarkClose   Decimal?     @map("benchmark_close") @db.Decimal(18, 4)
  // 렌더러 검증용 백필 구간 표식. 실제 보유 이력이 아니므로 성적 집계에서 제외한다.
  isBackfilled     Boolean      @default(false) @map("is_backfilled")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  positionSnapshots PaperPositionSnapshot[]

  @@unique([accountId, tradeDate])
  @@index([accountId, tradeDate])
  @@map("paper_equity_snapshot")
}

// 벤치마크(코스피 등 시장 지표)의 일별 종가. 종목이 아니라 지수라 Ticker/DailyPrice 에 넣지 않는다 —
// 유니버스 조회와 주가 감시가 Ticker 를 스캔하므로 지수 행이 섞이면 스캔 경로마다 배제 가드가 필요해진다.
// 토스 `/api/v1/market-indicators/{symbol}/candles` 가 소급 조회를 지원하므로(before/nextBefore)
// 이 표는 과거 구간도 나중에 채울 수 있다.
model BenchmarkDailyClose {
  id        Int      @id @default(autoincrement())
  // 토스 시장 지표 심볼. 현재 'KOSPI' 만 쓴다. 값 공간은 KOSPI|KOSDAQ|KR_BOND_* 8종.
  symbol    String
  tradeDate DateTime @map("trade_date") @db.Date
  close     Decimal  @db.Decimal(18, 4)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([symbol, tradeDate])
  @@map("benchmark_daily_close")
}

// 채점 결과 원장. 계산만 하고 슬랙으로 흘려보내면 규칙을 v3 으로 바꿨을 때 v2 시절 성적이
// 남지 않아 "바꿔서 나아졌나" 를 영영 가릴 수 없다. StockAlert/AlertOutcome 과 같은 목적이다.
model RecommendationScore {
  id                      Int          @id @default(autoincrement())
  accountId               Int          @map("account_id")
  account                 PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy                String
  // 채점 기준일. 이 행은 계좌 개설 이후 이 날짜까지의 누적 성적이다 — 구간 집계는 남기지 않는다.
  asOf                    DateTime     @map("as_of") @db.Date
  // 이 집계에 들어간 추천들이 어느 규칙 버전에서 나왔는지. 값이 둘 이상이면 규칙이 바뀐 구간을
  // 걸친 집계라는 뜻이다.
  ruleVersions            Int[]        @map("rule_versions")
  // 버전을 적기 전에 만들어진 추천 수. ruleVersions 에서 빠지는 값이라 여기 세지 않으면
  // "일부는 어느 규칙인지 모른다" 는 사실이 사라져 섞인 표본이 순수한 v2 성적처럼 보인다.
  unknownRuleVersionCount Int          @map("unknown_rule_version_count")
  // 이 집계 구간의 매도 주문에 박힌 청산 밴드 설정들 (`+10/-5` 꼴). 값이 둘 이상이면 밴드를
  // 바꾼 구간을 걸친 집계라는 뜻이다. 사이클별 귀속이 아니라 구간에 등장한 설정의 집합이다 —
  // 구간을 잘라 보는 것은 구간 집계가 생긴 뒤의 일이고, 그전까지 이 필드는 "섞였다" 를 알린다.
  exitBands               String[]     @map("exit_bands")
  // 밴드가 만들지 않은 매도 건수(모델이 고른 매도). 밴드 성적을 논할 때 분모에서 빠져야 하는
  // 매도가 몇 건인지 남기지 않으면 밴드 설정 하나로 닫힌 표본처럼 읽힌다.
  //
  // default 를 둔 이유는 이 축이 생기기 전 행 때문이다. 행이 있는 테이블에 default 없는 필수
  // 컬럼을 추가하면 Postgres 가 거부해서(`Null constraint failed`) 이 레포의 표준 배포인
  // `pnpm db:push` 가 통째로 막힌다. 쓰는 경로는 항상 값을 넘기므로 default 가 실제로 쓰이는
  // 것은 옛 행뿐이고, 위 exitBands 는 Prisma 스칼라 리스트라 DB 에서 이미 nullable 이다.
  bandlessSellCount       Int          @default(0) @map("bandless_sell_count")

  recommendationCount Int @map("recommendation_count")
  closedCount         Int @map("closed_count")
  openCount           Int @map("open_count")
  expiredCount        Int @map("expired_count")
  hitCount            Int @map("hit_count")

  hitRate              Decimal? @map("hit_rate") @db.Decimal(9, 4)
  meanReturnRate       Decimal? @map("mean_return_rate") @db.Decimal(9, 4)
  medianReturnRate     Decimal? @map("median_return_rate") @db.Decimal(9, 4)
  maximumLoss          Decimal? @map("maximum_loss") @db.Decimal(9, 4)
  averageHoldingDays   Decimal? @map("average_holding_days") @db.Decimal(9, 4)
  meanExcessReturnRate Decimal? @map("mean_excess_return_rate") @db.Decimal(9, 4)
  meanShadowReturnRate Decimal? @map("mean_shadow_return_rate") @db.Decimal(9, 4)

  snapshotCount     Int      @map("snapshot_count")
  accountReturnRate Decimal? @map("account_return_rate") @db.Decimal(9, 4)
  maximumDrawdown   Decimal? @map("maximum_drawdown") @db.Decimal(9, 4)
  turnoverRate      Decimal? @map("turnover_rate") @db.Decimal(18, 6)
  cumulativeCost    Decimal  @map("cumulative_cost") @db.Decimal(18, 4)

  // 집계에서 빠진 건수. 성적이 아니라 그 성적을 얼마나 믿을지의 재료라 통째로 남긴다.
  exclusions Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([accountId, asOf])
  @@index([strategy, asOf])
  @@map("recommendation_score")
}

// 추천 성적을 "어느 청산 밴드에서 나온 것인가" 로 갈라 센 구간 집계.
//
// `RecommendationScore` 는 (계좌, 기준일) 당 한 행에 계좌 개설 이후 전 구간을 누적한다.
// 2026-08-21 에 청산 밴드가 `+2/-0.2` → `+10/-5` 로 바뀌었으므로(PR #361), 누적 행만으로는
// 바꾼 값이 나은지 판정할 수 없다. `exitBands` 배열이 "섞였다" 를 알릴 뿐이었다.
//
// 계좌 전체 지표(자산 수익률·MDD·회전율)는 구간으로 자를 수 없어 누적 행에 남긴다.
// 이 표에는 사이클 성적만 담는다.
model RecommendationScorePeriod {
  id        Int          @id @default(autoincrement())
  accountId Int          @map("account_id")
  account   PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asOf      DateTime     @map("as_of") @db.Date
  // 구간 라벨 — 청산 밴드 설정(`+10/-5` 꼴) 또는 밴드가 만들지 않은 매도를 뜻하는 'BANDLESS'.
  periodLabel String @map("period_label")
  strategy    String

  closedCount        Int      @map("closed_count")
  hitCount           Int      @map("hit_count")
  hitRate            Decimal? @map("hit_rate") @db.Decimal(9, 4)
  meanReturnRate     Decimal? @map("mean_return_rate") @db.Decimal(9, 4)
  medianReturnRate   Decimal? @map("median_return_rate") @db.Decimal(9, 4)
  maximumLoss        Decimal? @map("maximum_loss") @db.Decimal(9, 4)
  averageHoldingDays Decimal? @map("average_holding_days") @db.Decimal(9, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId, asOf, periodLabel, strategy])
  @@index([periodLabel, asOf])
  @@map("recommendation_score_period")
}

// 스크리닝 회차. "그날 규칙이 무엇을 통과시켰나" 를 남긴다 — 산 것은 paper_order 에
// 남지만 통과하고도 안 산 종목은 어디에도 남지 않아, 규칙을 고칠 때 대조군이 없었다.
// 같은 기준일을 다시 돌리면 덮어쓴다. 스크리닝은 그날 종가를 읽어 순위를 매기는 순수
// 함수라 같은 기준일이면 결과가 같고, 행이 쌓이면 어느 것이 정본인지 알 수 없게 된다.
model ScreeningRun {
  id          Int      @id @default(autoincrement())
  strategy    String
  // 종가 기준일. 실행일이 아니다 — 휴일 다음 날 실행은 직전 거래일 종가를 본다.
  asOf        DateTime @map("as_of") @db.Date
  // 이 회차를 만든 규칙 버전. 규칙이 바뀌면 통과 목록의 의미도 바뀐다.
  ruleVersion Int      @map("rule_version")

  // 이 회차를 만든 추천 실행. null 이면 CLI 로 사람이 확인차 돌린 회차다.
  // 회차는 모델 호출보다 먼저 확정되므로, 쿼터 소진처럼 추천이 실패한 날은 회차만 남고
  // 주문이 없다. 그 회차를 걸러내지 않고 조인하면 실린 종목 전부가 "보고도 안 샀다" 로
  // 집계돼 대조군이 오염된다 — 대조군은 이 실행이 성공한 회차만이다.
  agentRunId Int?      @map("agent_run_id")
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  universeCount  Int @map("universe_count")
  evaluatedCount Int @map("evaluated_count")
  // 종가 기준일이 뒤처져 횡단면 순위에서 빠진 종목 수.
  staleCount     Int @map("stale_count")
  // 규칙을 통과한 전체 종목 수.
  passedCount    Int @map("passed_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items ScreeningRunItem[]

  @@unique([strategy, asOf])
  @@index([asOf])
  @@index([agentRunId])
  @@map("screening_run")
}

// 회차의 통과 종목. **통과 전체가 들어온다** — 그날 프롬프트에 실린 상위 목록과 통과만
// 하고 상한 밖으로 밀린 나머지가 `presented` 로 갈린다.
//
// 역할을 가르지 않고 한 덩어리로 쌓으면 "보고도 안 산 것" 대조군에 모델이 본 적조차 없는
// 종목이 섞여, 안 산 이유가 될 수 없는 것까지 선택의 실패로 집계된다. 읽는 쪽은 그 축을
// 반드시 갈라야 한다.
model ScreeningRunItem {
  id    Int          @id @default(autoincrement())
  runId Int          @map("run_id")
  run   ScreeningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  tickerId Int    @map("ticker_id")
  ticker   Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  // 점수 내림차순 순위(1 부터). 점수는 통과 후보 전체를 모집단으로 계산되므로
  // 이 순위와 점수는 같은 회차 안에서만 서로 비교된다.
  rank              Int
  score             Decimal @db.Decimal(9, 4)
  // 그날 추천 프롬프트에 실렸는가. false 는 규칙은 통과했지만 상한 밖이라 모델이 본 적
  // 없는 종목이다 — "보고도 안 샀다" 의 모집단은 true 뿐이고, false 는 상위 절단이
  // 나머지 통과분보다 나았는지를 재는 별도의 대조군이다.
  //
  // 기본값 true 는 이 컬럼을 모르는 쓰기를 위한 것이다. 컬럼이 생기기 전 440행과, 이
  // 변경이 배포되기 전 코드가 남기는 행은 전부 상위 목록뿐이라 true 가 사실과 맞는다.
  // 기본값을 빼면 옛 코드의 그날 회차가 통째로 실패한다.
  presented         Boolean @default(true)
  // paper_order.indicator_snapshot 과 같은 형태를 담는다. 산 종목과 안 산 종목을
  // 같은 축으로 비교하려면 지표가 양쪽에 같은 꼴로 있어야 한다.
  indicatorSnapshot Json    @map("indicator_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  outcomes ScreeningItemOutcome[]

  @@unique([runId, tickerId])
  @@index([tickerId])
  @@map("screening_run_item")
}

// 회차에 실린 종목의 사후 성적. 산 종목과 안 산 종목을 같은 잣대로 재서 "고른 것이
// 나았나" 를 묻기 위한 것이다 — 비용과 실제 체결을 반영하는 recommendation_score 와
// 목적이 다르다.
//
// 지평마다 행을 따로 둔다(AlertOutcome 과 같은 형태). 한 행에 5일·20일 컬럼을 나란히
// 두면 "20일치는 아직 안 왔다" 와 "계산에 실패했다" 가 똑같이 null 로 보인다.
//
// 다만 **행이 없다고 해서 전부 "아직" 은 아니다.** 진입일 시가가 영영 채워지지 않는
// 항목도 행이 없는 채로 남고, 매 회차 다시 조회된다. 지금은 그 사유를 원장이 아니라
// 실행 결과(카드)에만 남긴다 — 재조회 비용이 회차당 종목 수 수준이라 감당되고,
// 실패를 행으로 남기면 "잰 것" 과 "못 잰 것" 이 같은 테이블에 섞인다.
model ScreeningItemOutcome {
  id     Int              @id @default(autoincrement())
  itemId Int              @map("item_id")
  item   ScreeningRunItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // 진입일로부터 몇 거래일 뒤를 봤는가. 달력이 아니라 저장된 봉의 수로 센다 — 휴장일과
  // 수집이 빈 날을 달력으로 세면 종목마다 다른 날을 비교하게 된다.
  horizonDays Int @map("horizon_days")

  // 진입은 기준일 다음 거래일 시가다. 실제 매수도 같은 자리에서 체결되므로 산 종목과
  // 안 산 종목이 같은 출발선에 선다. 실제 체결가를 쓰면 산 쪽에만 체결 편차가 걸린다.
  entryTradeDate DateTime @map("entry_trade_date") @db.Date
  entryPrice     Decimal  @map("entry_price") @db.Decimal(18, 4)

  horizonTradeDate DateTime @map("horizon_trade_date") @db.Date
  horizonPrice     Decimal  @map("horizon_price") @db.Decimal(18, 4)

  // 수수료·세금을 넣지 않은 총수익률(%). 대조군은 실제로 사지 않아 비용이 없으므로,
  // 비용을 넣으면 산 쪽만 불리해져 비교가 기운다.
  returnPct Decimal @map("return_pct") @db.Decimal(18, 4)

  evaluatedAt DateTime @default(now()) @map("evaluated_at")

  @@unique([itemId, horizonDays])
  @@index([horizonDays])
  @@map("screening_item_outcome")
}

// 운영과 백테스트가 함께 읽는 조정 가능한 파라미터. 코드 상수를 여기로 내려, 값을 바꾸는 일이
// 코드 수정이 아니라 행 추가가 되게 한다.
//
// 코드 상수는 지우지 않고 이 테이블이 비었을 때의 기본값으로 남는다 — 조회가 실패해도 그날
// 추천 회차는 돌아야 한다. 값을 고르는 순서는 `CLI 인자 > 활성 행 > 코드 상수` 이고, CLI 가
// 가장 세다. 탐색기가 같은 축의 후보를 차례로 재는데 활성 행이 인자를 이기면 후보를 몇 개
// 주든 전부 같은 값으로 돌게 된다.
//
// 설계 근거: docs/superpowers/specs/2026-08-25-strategy-parameter-loop-design.md
model StrategyParameter {
  id       Int    @id @default(autoincrement())
  strategy String
  name     String

  value Decimal @db.Decimal(18, 4)

  // (strategy, name) 안에서 1부터 오른다. 되돌리기는 행을 지우는 것이 아니라 이전 값으로
  // 새 버전을 만들어 활성화하는 것이다 — 무엇이 언제 왜 바뀌었는지가 남아야 반영 후 성적을
  // 그 변경에 귀속시킬 수 있다.
  version Int

  // 활성 행은 `activatedAt IS NOT NULL AND supersededAt IS NULL` 인 하나다. 둘 다 null 인
  // 행은 만들어졌지만 승인되지 않은 제안이다.
  //
  // 이 단일성은 아래 `@@unique` 로 안 걸린다 — (strategy, name, version) 유니크는 v1 과 v2 가
  // 동시에 활성인 상태를 막지 못한다. Prisma 스키마가 부분 유니크 인덱스를 표현하지 못해,
  // 실제 강제는 `prisma.service.ts` 부팅 훅의 `idx_strategy_parameter_active`
  // (WHERE activated_at IS NOT NULL AND superseded_at IS NULL) 가 한다. `db:push` 가 그
  // 인덱스를 지우지만 다음 부팅이 되살린다(pgvector HNSW 인덱스와 같은 취급).
  activatedAt  DateTime? @map("activated_at")
  supersededAt DateTime? @map("superseded_at")

  // 왜 이 값인가. 초기 seed 는 근거 문서 경로를 적는다. 이유 없는 값은 다음에 바꿀 때
  // 무엇을 되돌리는지 알 수 없게 만든다.
  reason String @db.Text

  // 이 값을 만든 실행. seed 와 손으로 넣은 행은 null 이다.
  agentRunId Int?      @map("agent_run_id")
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([strategy, name, version])
  @@index([strategy, name, activatedAt])
  @@map("strategy_parameter")
}

model JobPosting {
  id         Int    @id @default(autoincrement())
  source     String
  sourceId   String @map("source_id")
  company    String
  companyKey String @map("company_key")
  title      String
  detailUrl  String @map("detail_url")

  skillTags    String[] @map("skill_tags")
  rawSkillTags String[] @map("raw_skill_tags")

  minYears        Int?    @map("min_years")
  maxYears        Int?    @map("max_years")
  yearsSource     String  @map("years_source")
  rawJobLevel     String? @map("raw_job_level")
  experienceLevel String? @map("experience_level")

  locations    String[]
  rawLocations String[] @map("raw_locations")

  // 상위 후보만 채운다. null 이 정상이다.
  jdText          String?   @map("jd_text") @db.Text
  detailFetchedAt DateTime? @map("detail_fetched_at")

  normalizedKey String @map("normalized_key")
  contentHash   String @map("content_hash")

  matchScore      Int?           @map("match_score")
  scoredProfileId Int?           @map("scored_profile_id")
  scoredProfile   CareerProfile? @relation(fields: [scoredProfileId], references: [id], onDelete: SetNull)
  scoredAt        DateTime?      @map("scored_at")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  closedAt    DateTime? @map("closed_at")
  notifiedAt  DateTime? @map("notified_at")

  gapAgentRunId Int?      @map("gap_agent_run_id")
  gapAgentRun   AgentRun? @relation(fields: [gapAgentRunId], references: [id], onDelete: SetNull)

  applications JobApplication[]

  @@unique([source, sourceId])
  @@index([normalizedKey])
  @@index([notifiedAt, matchScore])
  @@index([companyKey])
  @@map("job_posting")
}
